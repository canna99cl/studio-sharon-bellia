{# Icone per le res-card, selezionabili dal pannello tramite un nome #}
{% macro resIcon(name) %}
{%- if name == "scudo" -%}
<svg class="res-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6l9-4 9 4-9 4-9-4Z"/><path d="M3 6v6c0 3 4 5 9 5s9-2 9-5V6"/></svg>
{%- elif name == "modulo" -%}
<svg class="res-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 2h6a2 2 0 0 1 2 2v0a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v0a2 2 0 0 1 2-2Z"/><path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"/></svg>
{%- elif name == "cuore" -%}
<svg class="res-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
{%- elif name == "bussola" -%}
<svg class="res-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m16 8-2 6-6 2 2-6 6-2Z"/></svg>
{%- else -%}
<svg class="res-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
{%- endif -%}
{% endmacro %}

{# Icone per le auth-card (pagina Competenze) #}
{% macro authIcon(name) %}
{%- if name == "piu" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v20M2 12h20"/></svg>
{%- elif name == "righe" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h12"/></svg>
{%- elif name == "libro" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
{%- else -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 3 2 6 2s6-1 6-2v-5"/></svg>
{%- endif -%}
{% endmacro %}

{# Elenco di note (<small>) per una voce, con link esterni in nuova scheda #}
{% macro notes(list) %}
{%- for n in list -%}
<small>{% if n.url %}<a href="{{ n.url }}"{% if n.url | ishttp %} target="_blank" rel="noopener"{% endif %}>{{ n.text }}</a>{% else %}{{ n.text }}{% endif %}{{ n.suffix }}</small>
{%- endfor -%}
{% endmacro %}
