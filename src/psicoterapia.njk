---
layout: base.njk
title: "Percorsi psicologici continuativi · Dott.ssa Sharon Maria Bellia — Caltanissetta"
description: "Percorsi psicologici continuativi a Caltanissetta e online, nel contesto della formazione presso una Scuola di Specializzazione in Psicoterapia riconosciuta."
permalink: "/psicoterapia.html"
---
{% set p = pages.psicoterapia %}
<main class="internal-page" id="main">
    <section class="subhero" aria-labelledby="page-title">
      <div class="container">
        <nav class="breadcrumb reveal" aria-label="Percorso di navigazione">
          <a href="index.html">Home</a><span>/</span><a href="index.html#ambiti">Ambiti</a><span>/</span>Percorsi continuativi
        </nav>
        <p class="eyebrow reveal">{{ p.subhero.eyebrow }}</p>
        <h1 class="display subhero__title blur-in" id="page-title">{{ p.subhero.title }}</h1>
        <p class="subhero__lede reveal">{{ p.subhero.lede }}</p>
        <div class="reveal">
          <a class="btn btn--primary" href="{{ p.subhero.button_href }}">{{ p.subhero.button_text }}</a>
        </div>
      </div>
    </section>

    <!-- NOTA TRASPARENZA -->
    <section class="detail detail--dark" aria-labelledby="nota-title">
      <div class="container">
        <div class="detail__head detail__head--compact">
          <p class="eyebrow reveal">{{ p.nota.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="nota-title">{{ p.nota.title }}</h2>
          <p class="detail__text reveal">{{ p.nota.text }}</p>
        </div>
      </div>
    </section>

    <!-- PER CHI -->
    <section class="detail" aria-labelledby="perchi-title">
      <div class="container">
        <div class="detail__head">
          <p class="eyebrow reveal">{{ p.situazioni.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="perchi-title">{{ p.situazioni.title }}</h2>
          <p class="detail__text reveal">{{ p.situazioni.text }}</p>
        </div>
        <div class="situations">
          {% for s in p.situazioni.items %}
          <div class="situation reveal"><h3>{{ s.title }}</h3><p>{{ s.text }}</p></div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- COME LAVORO -->
    <section class="detail detail--alt" aria-labelledby="come-title">
      <div class="container detail__cols">
        <div>
          <p class="eyebrow reveal">{{ p.come_lavoro.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="come-title">{{ p.come_lavoro.title }}</h2>
          <p class="detail__text reveal">{{ p.come_lavoro.text }}</p>
        </div>
        <ul class="method-list reveal">
          {% for step in p.come_lavoro.method %}
          <li><span class="n">{{ step.n }}</span><span><b>{{ step.title }}</b><span class="d">{{ step.desc }}</span></span></li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="faq__paths" aria-hidden="true">
        <svg viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice">
          <path d="M-50 480 C 300 380 500 520 760 430 S 1200 340 1500 440"/>
          <path d="M-50 520 C 320 430 520 560 780 470 S 1220 380 1500 480"/>
          <path d="M-50 560 C 340 470 540 600 800 510 S 1240 420 1500 520"/>
        </svg>
      </div>
      <div class="container">
        <div class="faq__grid">
          <div class="faq__head">
            <p class="eyebrow reveal">{{ p.faq.eyebrow }}</p>
            <h2 class="display faq__title blur-in" id="faq-title">{{ p.faq.title }}</h2>
          </div>
          <div class="faq__list reveal">
            {% for f in p.faq.items %}
            <details class="faq__item" name="faq"><summary>{{ f.q }} <span class="faq__icon" aria-hidden="true"></span></summary><div class="faq__answer">{{ f.a | safe }}</div></details>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-title">
      <div class="container">
        <h2 id="cta-title" class="reveal">{{ p.cta.title }}</h2>
        <p class="reveal">{{ p.cta.text }}</p>
        <div class="reveal"><a class="btn btn--light" href="{{ p.cta.button_href }}">{{ p.cta.button_text }}</a></div>
      </div>
    </section>
  </main>
