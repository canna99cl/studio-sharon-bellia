---
layout: base.njk
title: "Dove trovarmi · Studio a Caltanissetta — Dott.ssa Sharon Maria Bellia"
description: "Dove trovarmi: lo studio di psicologia della Dott.ssa Sharon Maria Bellia a Caltanissetta. Indirizzo, mappa e indicazioni per raggiungermi, oppure sedute online."
permalink: "/dove-trovarmi.html"
---
{% set p = pages["dove-trovarmi"] %}
<main class="internal-page" id="main">
    <section class="subhero" aria-labelledby="page-title">
      <div class="container">
        <nav class="breadcrumb reveal" aria-label="Percorso di navigazione">
          <a href="index.html">Home</a><span>/</span>Dove trovarmi
        </nav>
        <p class="eyebrow reveal">{{ p.subhero.eyebrow }}</p>
        <h1 class="display subhero__title blur-in" id="page-title">{{ p.subhero.title }}</h1>
        <p class="subhero__lede reveal">{{ p.subhero.lede }}</p>
      </div>
    </section>

    <!-- MAPPA Google incorporata. Filtro CSS caldo per restare in palette;
         al passaggio del mouse torna nitida. Il link sotto apre le indicazioni stradali. -->
    <section class="locate section--flush-top" aria-label="Dove trovarmi">
      <div class="container">
        <div class="locate__grid">
          <div class="locate__map">
            <div class="map-embed reveal">
              <iframe title="Mappa dello studio — {{ site.address_street }}, {{ site.address_city }}" src="https://www.google.com/maps?q={{ site.maps_embed_query }}&amp;z=16&amp;hl=it&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
            <a class="map-embed__cta reveal" href="{{ site.maps_url }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {{ p.map_cta }}
            </a>
          </div>

          <div class="locate__info">
            <p class="eyebrow reveal">{{ p.recapiti_eyebrow }}</p>
            <ul class="info-list info-list--spaced reveal">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <div><b>Studio</b><span>{{ site.address_street }}, {{ site.address_postal }} {{ site.address_city }} ({{ site.address_province }})</span></div>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16v14H4zM4 7l8 6 8-6"/></svg>
                <div><b>Email</b><span>{{ site.email }}</span></div>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
                <div><b>Telefono</b><span>{{ site.phone_display }}</span></div>
              </li>
            </ul>

            <p class="locate__sub reveal">{{ p.hours_title }}</p>
            <ul class="hours reveal">
              {% for h in site.hours %}<li>{{ h.label }} <span>{{ h.value }}</span></li>{% endfor %}
            </ul>
            <p class="locate__note reveal">{{ p.note }}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-title">
      <div class="container">
        <h2 id="cta-title" class="reveal">{{ p.cta.title }}</h2>
        <p class="reveal">{{ p.cta.text }}</p>
        <div class="reveal"><a class="btn btn--light" href="{{ p.cta.button_href }}">{{ p.cta.button_text }}</a></div>
      </div>
    </section>
  </main>
