---
layout: base.njk
title: "Risorse e materiali da scaricare · Dott.ssa Sharon Maria Bellia — Caltanissetta"
description: "Guide e materiali gratuiti da scaricare: cosa aspettarsi dal primo colloquio, cosa fa una CTP, modulistica e consenso informato. Studio della Dott.ssa Sharon Maria Bellia."
permalink: "/risorse.html"
---
{% import "macros.njk" as m %}
{% set p = pages.risorse %}
<main class="internal-page" id="main">
    <section class="subhero" aria-labelledby="page-title">
      <div class="container">
        <nav class="breadcrumb reveal" aria-label="Percorso di navigazione">
          <a href="index.html">Home</a><span>/</span>Risorse
        </nav>
        <p class="eyebrow reveal">{{ p.subhero.eyebrow }}</p>
        <h1 class="display subhero__title blur-in" id="page-title">{{ p.subhero.title }}</h1>
        <p class="subhero__lede reveal">{{ p.subhero.lede }}</p>
      </div>
    </section>

    <!-- I "Scarica" puntano al form della home (richiesta via email). In produzione:
         plugin che invia il link dopo l'inserimento dell'email. PDF in assets/files/. -->
    <section class="resources section--flush-top" aria-label="Materiali scaricabili">
      <div class="container">
        <div class="res-cards">
          {% for card in p.cards %}
          <article class="res-card reveal">
            {{ m.resIcon(card.icon) }}
            <h2 class="card__h">{{ card.title }}</h2>
            <p>{{ card.text }}</p>
            <a class="res-card__link" href="{{ card.link_href }}">{{ card.link_text }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v14M6 11l6 6 6-6M5 21h14"/></svg>
            </a>
          </article>
          {% endfor %}
        </div>
        <p class="section-note reveal">{{ p.note }}</p>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-title">
      <div class="container">
        <h2 id="cta-title" class="reveal">{{ p.cta.title }}</h2>
        <p class="reveal">{{ p.cta.text }}</p>
        <div class="reveal"><a class="btn btn--light" href="{{ p.cta.button_href }}">{{ p.cta.button_text }}</a></div>
      </div>
    </section>
  </main>
