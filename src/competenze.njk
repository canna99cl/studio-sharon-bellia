---
layout: base.njk
title: "Competenze, formazione ed esperienza · Dott.ssa Sharon Maria Bellia — Caltanissetta"
description: "Formazione accademica, specializzazione in corso e approfondimento giuridico-forense della Dott.ssa Sharon Maria Bellia, psicologa a Caltanissetta."
permalink: "/competenze.html"
---
{% import "macros.njk" as m %}
{% set p = pages.competenze %}
<main class="internal-page" id="main">
    <section class="subhero" aria-labelledby="page-title">
      <div class="container">
        <nav class="breadcrumb reveal" aria-label="Percorso di navigazione">
          <a href="index.html">Home</a><span>/</span>Competenze
        </nav>
        <p class="eyebrow reveal">{{ p.subhero.eyebrow }}</p>
        <h1 class="display subhero__title blur-in" id="page-title">{{ p.subhero.title }}</h1>
        <p class="subhero__lede reveal">{{ p.subhero.lede }}</p>
      </div>
    </section>

    <section class="credentials-strip" aria-label="Credenziali essenziali">
      <div class="container credentials-strip__inner">
        {% for it in p.strip.items %}<span>{% if it.strong %}<b>{{ it.text }}</b>{% else %}{{ it.text }}{% endif %}</span>{% endfor %}
        <a href="{{ p.strip.link_url }}" target="_blank" rel="noopener">{{ p.strip.link_text }}</a>
      </div>
    </section>

    <section class="authority section--flush-top" id="formazione" aria-labelledby="formazione-title">
      <div class="container">
        <h2 class="sr-only" id="formazione-title">Formazione ed esperienza</h2>
        <div class="authority__grid">
          {% for card in p.cards %}
          <div class="auth-card reveal">
            <h3>{{ m.authIcon(card.icon) }}{{ card.title }}</h3>
            <ul>
              {% for item in card.items %}
              <li>{{ item.text }}{{ m.notes(item.notes) }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-title">
      <div class="container">
        <h2 id="cta-title" class="reveal">{{ p.cta.title }}</h2>
        <p class="reveal">{{ p.cta.text }}</p>
        <div class="reveal"><a class="btn btn--light" href="{{ p.cta.button_href }}">{{ p.cta.button_text }}</a></div>
      </div>
    </section>
  </main>
