---
layout: base.njk
title: "Percorso e modalità · Dott.ssa Sharon Maria Bellia — Caltanissetta"
description: "Dal primo contatto alla definizione del percorso: destinatari, durata, frequenza, incontri in studio e online e informazioni organizzative."
permalink: "/percorso-modalita.html"
---
{% set p = pages["percorso-modalita"] %}
<main class="internal-page" id="main">
    <section class="subhero" aria-labelledby="page-title">
      <div class="container">
        <nav class="breadcrumb reveal" aria-label="Percorso di navigazione">
          <a href="index.html">Home</a><span>/</span>Percorso e modalità
        </nav>
        <p class="eyebrow reveal">{{ p.subhero.eyebrow }}</p>
        <h1 class="display subhero__title blur-in" id="page-title">{{ p.subhero.title }}</h1>
        <p class="subhero__lede reveal">{{ p.subhero.lede }}</p>
      </div>
    </section>

    <nav class="page-index" aria-label="In questa pagina">
      <div class="container page-index__inner">
        <span class="page-index__label">In questa pagina</span>
        <a href="#percorso">Come funziona</a>
        <a href="#destinatari">Destinatari</a>
        <a href="#incontri">Incontri</a>
        <a href="#online">Online</a>
        <a href="#adolescenti">Adolescenti</a>
        <a href="#spostamenti">Spostamenti</a>
        <a href="#urgenze">Urgenze</a>
      </div>
    </nav>

    <section class="journey" id="percorso" aria-labelledby="journey-title">
      <div class="container">
        <div class="percorso__head reveal">
          <p class="eyebrow">{{ p.journey.eyebrow }}</p>
          <h2 class="display percorso__title" id="journey-title">{{ p.journey.title }}</h2>
        </div>
        <div class="steps">
          {% for s in p.journey.steps %}
          <div class="step reveal">
            <div class="step__num">{{ s.num }}</div>
            <h3 class="step__title">{{ s.title }}</h3>
            <p class="step__text">{{ s.text }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="operations" aria-label="Informazioni operative">
      <div class="container">
        <div class="operations__grid">
          {% for op in p.operations %}
          <article class="operation-card{% if op.wide %} operation-card--wide{% endif %} reveal" id="{{ op.id }}">
            <h2 class="display">{{ op.title }}</h2>
            <p>{{ op.text }}</p>
          </article>
          {% endfor %}
        </div>
        <p class="operation-note reveal">{{ p.operation_note }}</p>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-title">
      <div class="container">
        <h2 id="cta-title" class="reveal">{{ p.cta.title }}</h2>
        <p class="reveal">{{ p.cta.text }}</p>
        <div class="reveal"><a class="btn btn--light" href="{{ p.cta.button_href }}">{{ p.cta.button_text }}</a></div>
      </div>
    </section>
  </main>
