---
layout: base.njk
title: "Psicologia forense e giuridica · Dott.ssa Sharon Maria Bellia — Caltanissetta"
description: "Psicologia forense a Caltanissetta: consulenza tecnica di parte (CTP), valutazione delle capacità genitoriali, ascolto del minore, perizie e relazioni psicologiche in ambito civile e penale."
permalink: "/psicologia-forense.html"
---
{% set p = pages["psicologia-forense"] %}
<main class="internal-page" id="main">
    <section class="subhero" aria-labelledby="page-title">
      <div class="container">
        <nav class="breadcrumb reveal" aria-label="Percorso di navigazione">
          <a href="index.html">Home</a><span>/</span><a href="index.html#ambiti">Ambiti</a><span>/</span>Psicologia forense
        </nav>
        <p class="eyebrow reveal">{{ p.subhero.eyebrow }}</p>
        <h1 class="display subhero__title blur-in" id="page-title">{{ p.subhero.title }}</h1>
        <p class="subhero__lede reveal">{{ p.subhero.lede }}</p>
        <div class="reveal">
          <a class="btn btn--primary" href="{{ p.subhero.button_href }}">{{ p.subhero.button_text }}</a>
        </div>
      </div>
    </section>

    <!-- DESTINATARI -->
    <section class="detail" id="destinatari-forense" aria-labelledby="destinatari-title">
      <div class="container">
        <div class="detail__head">
          <p class="eyebrow reveal">{{ p.destinatari.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="destinatari-title">{{ p.destinatari.title }}</h2>
          <p class="detail__text reveal">{{ p.destinatari.text }}</p>
        </div>
        <div class="situations">
          {% for s in p.destinatari.items %}
          <article class="situation reveal"><h3>{{ s.title }}</h3><p>{{ s.text }}</p></article>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- RUOLI -->
    <section class="detail detail--alt" id="ruoli-forense" aria-labelledby="ruoli-title">
      <div class="container">
        <div class="detail__head">
          <p class="eyebrow reveal">{{ p.ruoli.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="ruoli-title">{{ p.ruoli.title }}</h2>
          <p class="detail__text reveal">{{ p.ruoli.text }}</p>
        </div>
        <div class="situations situations--four">
          {% for s in p.ruoli.items %}
          <article class="situation reveal"><h3>{{ s.title }}</h3><p>{{ s.text }}</p></article>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- AMBITI -->
    <section class="detail" id="ambiti-forensi" aria-labelledby="ambiti-forensi-title">
      <div class="container">
        <div class="detail__head">
          <p class="eyebrow reveal">{{ p.ambiti.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="ambiti-forensi-title">{{ p.ambiti.title }}</h2>
          <p class="detail__text reveal">{{ p.ambiti.text }}</p>
        </div>
        <div class="forensic-areas">
          {% for area in p.ambiti.areas %}
          <article class="forensic-area reveal">
            <h3>{{ area.title }}</h3>
            <ul>
              {% for v in area.list %}<li>{{ v }}</li>{% endfor %}
            </ul>
          </article>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- CONFINI PROFESSIONALI -->
    <section class="detail detail--alt" id="confini-forensi" aria-labelledby="come-title">
      <div class="container detail__cols">
        <div>
          <p class="eyebrow reveal">{{ p.confini.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="come-title">{{ p.confini.title }}</h2>
          <p class="detail__text reveal">{{ p.confini.text }}</p>
        </div>
        <ul class="method-list reveal">
          {% for step in p.confini.method %}
          <li><span class="n">{{ step.n }}</span><span><b>{{ step.title }}</b><span class="d">{{ step.desc }}</span></span></li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <!-- COME SI SVOLGE UN INCARICO -->
    <section class="detail" id="processo-forense" aria-labelledby="steps-title">
      <div class="container">
        <div class="detail__head">
          <p class="eyebrow reveal">{{ p.processo.eyebrow }}</p>
          <h2 class="display detail__title blur-in" id="steps-title">{{ p.processo.title }}</h2>
        </div>
        <div class="steps steps--six">
          {% for s in p.processo.steps %}
          <div class="step reveal"><div class="step__num">{{ s.num }}</div><h3 class="step__title">{{ s.title }}</h3><p class="step__text">{{ s.text }}</p></div>
          {% endfor %}
        </div>
        <p class="section-note reveal">{{ p.processo.note }}</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="faq__paths" aria-hidden="true">
        <svg viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice">
          <path d="M-50 480 C 300 380 500 520 760 430 S 1200 340 1500 440"/>
          <path d="M-50 520 C 320 430 520 560 780 470 S 1220 380 1500 480"/>
          <path d="M-50 560 C 340 470 540 600 800 510 S 1240 420 1500 520"/>
        </svg>
      </div>
      <div class="container">
        <div class="faq__grid">
          <div class="faq__head">
            <p class="eyebrow reveal">{{ p.faq.eyebrow }}</p>
            <h2 class="display faq__title blur-in" id="faq-title">{{ p.faq.title }}</h2>
          </div>
          <div class="faq__list reveal">
            {% for f in p.faq.items %}
            <details class="faq__item" name="faq"><summary>{{ f.q }} <span class="faq__icon" aria-hidden="true"></span></summary><div class="faq__answer">{{ f.a | safe }}</div></details>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-title">
      <div class="container">
        <h2 id="cta-title" class="reveal">{{ p.cta.title }}</h2>
        <p class="reveal">{{ p.cta.text }}</p>
        <div class="reveal"><a class="btn btn--light" href="{{ p.cta.button_href }}">{{ p.cta.button_text }}</a></div>
      </div>
    </section>
  </main>
