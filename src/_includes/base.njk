{% set homePrefix = "" if isHome else "index.html" %}<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title if title else site.name }}</title>
  <meta name="description" content="{{ description if description else site.description }}" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#F5F2EB" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content="{{ site.name }} — {{ site.qualification }}" />
  <meta property="og:title" content="{{ title if title else site.name }}" />
  <meta property="og:description" content="{{ description if description else site.description }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ title if title else site.name }}" />
  <meta name="twitter:description" content="{{ description if description else site.description }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="/assets/css/styles.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" /></noscript>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "Psychologist"],
        "@id": "https://{{ site.domain }}/#studio",
        "name": "{{ site.name }} — Studio di Psicologia",
        "description": "Attività psicologica in area clinica e giuridico-forense a {{ site.address_city }}.",
        "url": "https://{{ site.domain }}/",
        "telephone": "{{ site.phone_display }}",
        "email": "{{ site.email }}",
        "image": "https://{{ site.domain }}/favicon.svg",
        "priceRange": "€€",
        "hasMap": "{{ site.maps_url }}",
        "address": { "@type": "PostalAddress", "streetAddress": "{{ site.address_street }}", "addressLocality": "{{ site.address_city }}", "addressRegion": "{{ site.address_province }}", "postalCode": "{{ site.address_postal }}", "addressCountry": "IT" },
        "areaServed": [ { "@type": "City", "name": "{{ site.address_city }}" }, { "@type": "AdministrativeArea", "name": "Sicilia" } ],
        "sameAs": ["{{ site.social.facebook }}", "{{ site.social.instagram }}"],
        "founder": { "@id": "https://{{ site.domain }}/#persona" }
      },
      {
        "@type": "Person",
        "@id": "https://{{ site.domain }}/#persona",
        "name": "{{ site.name }}",
        "jobTitle": "{{ site.qualification }} — attività in area clinica e giuridico-forense",
        "worksFor": { "@id": "https://{{ site.domain }}/#studio" },
        "address": { "@type": "PostalAddress", "addressLocality": "{{ site.address_city }}", "addressCountry": "IT" },
        "knowsLanguage": "it"
      }
    ]
  }
  </script>
</head>
<body data-whatsapp="{{ site.whatsapp_number }}" data-whatsapp-msg="{{ site.whatsapp_message }}">
  <a class="skip-link" href="#main">Vai al contenuto</a>

  <div class="preloader" id="preloader" aria-hidden="true">
    <svg class="preloader__ring" viewBox="0 0 84 84" role="presentation">
      <circle class="preloader__track" cx="42" cy="42" r="41"></circle>
      <circle class="preloader__path" cx="42" cy="42" r="41"></circle>
    </svg>
    <span class="preloader__label">Un momento…</span>
  </div>

  <header class="header" id="header">
    <div class="container header__inner">
      <a class="brand" href="{{ '#top' if isHome else 'index.html' }}" aria-label="{{ site.name }} — Home">
        {{ site.name }}
        <small>{{ site.tagline }}</small>
      </a>
      <nav class="nav" aria-label="Navigazione principale">
        <ul class="nav__list" id="navList">
          <li><a href="{{ homePrefix }}#chi-sono">Chi sono</a></li>
          <li><a href="{{ homePrefix }}#ambiti">Ambiti</a></li>
          <li><a href="percorso-modalita.html">Percorso</a></li>
          <li><a href="competenze.html">Competenze</a></li>
          <li><a href="articoli.html">Articoli</a></li>
          <li><a href="{{ homePrefix }}#prenota">Contatti</a></li>
        </ul>
        <a class="btn btn--amber" href="{{ homePrefix }}#prenota">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/></svg>
          Contattami
        </a>
        <button class="nav__toggle" id="navToggle" aria-label="Apri il menu" aria-expanded="false" aria-controls="navList" type="button"><span></span></button>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div>
          <div class="footer__brand">{{ site.name }}<small>{{ site.qualification }} · area clinica e giuridico-forense</small></div>
          <p>Studio di psicologia a {{ site.address_city }}. Attività in area clinica, percorsi psicologici continuativi e consulenza giuridico-forense, con metodo rigoroso e cura della relazione.</p>
          <div class="footer__social">
            <a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
            <a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
          </div>
        </div>
        <details class="footer__menu" open>
          <summary class="footer__menu-title">Esplora</summary>
          <div class="footer__menu-content">
            <ul>
              <li><a href="{{ homePrefix }}#chi-sono">Chi sono</a></li>
              <li><a href="competenze.html">Competenze</a></li>
              <li><a href="articoli.html">Articoli</a></li>
              <li><a href="risorse.html">Risorse</a></li>
              <li><a href="{{ homePrefix }}#faq">FAQ</a></li>
              <li><a href="percorso-modalita.html">Percorso e modalità</a></li>
              <li><a href="dove-trovarmi.html">Sede e contatti</a></li>
            </ul>
          </div>
        </details>
        <details class="footer__menu" open>
          <summary class="footer__menu-title">Ambiti</summary>
          <div class="footer__menu-content">
            <ul>
              <li><a href="psicologia-clinica.html">Psicologia clinica</a></li>
              <li><a href="psicoterapia.html">Percorsi continuativi</a></li>
              <li><a href="psicologia-forense.html">Psicologia forense</a></li>
            </ul>
          </div>
        </details>
      </div>
      <div class="footer__bottom">
        <span>© <span id="year"></span> {{ site.name }} — P.IVA {{ site.piva }} · {{ site.albo }}</span>
        <span>Privacy · Cookie · Note legali</span>
      </div>
    </div>
  </footer>

  <script src="/assets/js/main.js" defer></script>
  <!-- Netlify Identity: gestisce i link di invito/login verso il pannello /admin/ -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function (user) {
        if (!user) {
          window.netlifyIdentity.on("login", function () {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
