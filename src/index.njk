---
layout: base.njk
isHome: true
title: "Dott.ssa Sharon Maria Bellia — Psicologa · Caltanissetta"
description: "Studio di psicologia a Caltanissetta: attività in area clinica e giuridico-forense, con percorsi costruiti con chiarezza e rigore."
permalink: "/index.html"
---
{% set ambitoClasses = ["ambito ambito--clinical", "ambito ambito--dark ambito--continuing", "ambito ambito--forensic"] %}
<main id="main">
    <span id="top"></span>

    <!-- ===================== HERO ===================== -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="landscape" aria-hidden="true">
        <!-- Colline stratificate (firma: paesaggio interiore). Parallax via JS. -->
        <svg class="landscape__layer" data-depth="0.12" viewBox="0 0 1440 500" preserveAspectRatio="none">
          <path fill="#E6D8C0" d="M0 320 Q 360 220 720 300 T 1440 280 V500 H0 Z"/>
        </svg>
        <svg class="landscape__layer" data-depth="0.22" viewBox="0 0 1440 460" preserveAspectRatio="none">
          <path fill="#D8C3A2" d="M0 300 Q 300 360 620 300 T 1200 280 T 1440 320 V460 H0 Z"/>
        </svg>
        <svg class="landscape__layer" data-depth="0.36" viewBox="0 0 1440 380" preserveAspectRatio="none">
          <path fill="#C2A578" d="M0 240 Q 380 320 760 250 T 1440 260 V380 H0 Z"/>
        </svg>
        <svg class="landscape__layer" data-depth="0.5" viewBox="0 0 1440 260" preserveAspectRatio="none">
          <path fill="#8A6E4C" d="M0 160 Q 420 240 820 170 T 1440 180 V260 H0 Z"/>
        </svg>
        <div class="grain"></div>
      </div>

      <div class="container hero__content">
        <p class="eyebrow hero__eyebrow reveal">{{ home.hero.eyebrow }}</p>
        <h1 class="display hero__title blur-in" id="hero-title">{{ home.hero.title | safe }}</h1>
        <p class="hero__lede reveal">{{ home.hero.subtitle }}</p>
        <div class="hero__actions reveal">
          <a class="btn btn--primary" href="{{ home.hero.cta_primary_href }}">{{ home.hero.cta_primary_label }}</a>
          <a class="btn btn--ghost" href="{{ home.hero.cta_secondary_href }}">{{ home.hero.cta_secondary_label }}</a>
        </div>
        <p class="hero__availability reveal">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {{ home.hero.availability }}
        </p>
      </div>
    </section>

    <!-- ===================== INTRO NARRATIVA ===================== -->
    <section class="intro" aria-labelledby="intro-sign">
      <div class="container intro__inner">
        <p class="stanza js-words">{{ home.intro_narrativa.text | safe }}</p>
        <p class="intro__sign reveal" id="intro-sign">{{ home.intro_narrativa.sign }}</p>
      </div>
    </section>

    <!-- ===================== CHI SONO (esteso) ===================== -->
    <section class="about" id="chi-sono" aria-labelledby="about-title">
      <div class="container about__grid">
        <div class="about__portrait reveal">
          <div class="about__frame">
            <!-- Segnaposto ritratto: sostituire con foto professionale reale (WebP). -->
            <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <rect width="400" height="500" fill="#B9A588"/>
              <path d="M0 360 Q 100 300 200 350 T 400 340 V500 H0 Z" fill="#9C8768" opacity=".7"/>
              <circle cx="200" cy="205" r="72" fill="#F3ECDD" opacity=".92"/>
              <path d="M128 420 q72 -96 144 0 Z" fill="#F3ECDD" opacity=".92"/>
            </svg>
          </div>
          <p class="about__caption">{{ home.about.portrait_caption }}</p>
        </div>
        <div class="about__main">
          <p class="eyebrow reveal">{{ home.intro.eyebrow }}</p>
          <h2 class="display about__title blur-in" id="about-title">{{ home.intro.title }}</h2>
          <p class="about__lede reveal">{{ home.intro.text }}</p>
          {% for p in home.about.paragraphs %}
          <p class="about__text reveal">{{ p | safe }}</p>
          {% endfor %}

          <ul class="credentials reveal">
            {% for c in home.about.credentials %}
            <li>
              <span class="yr">{{ c.label }}</span>
              <span class="txt">{{ c.text }}<small><a href="{{ c.source_url }}" target="_blank" rel="noopener">{{ c.source_text }}</a>{{ c.source_suffix }}</small></span>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>

    <!-- ===================== AMBITI ===================== -->
    <section class="ambiti" id="ambiti" aria-labelledby="ambiti-title">
      <header class="ambiti__intro container reveal">
        <p class="eyebrow">{{ home.ambiti.eyebrow }}</p>
        <h2 class="display" id="ambiti-title">{{ home.ambiti.title }}</h2>
        <p>{{ home.ambiti.text }}</p>
      </header>

      {% for a in home.ambiti.items %}
      <article class="{{ ambitoClasses[loop.index0] if ambitoClasses[loop.index0] else 'ambito ambito--clinical' }}">
        <div class="ambito__bg" aria-hidden="true">
          {% if loop.index0 == 1 %}
          <svg viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
            <path fill="#3E352B" d="M0 420 Q 380 360 760 420 T 1440 400 V600 H0 Z"/>
            <path fill="#332B22" d="M0 500 Q 420 470 820 510 T 1440 500 V600 H0 Z"/>
          </svg>
          {% elif loop.index0 == 2 %}
          <svg viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
            <path fill="#EDE4D2" d="M0 450 Q 360 400 720 440 T 1440 420 V600 H0 Z" opacity=".8"/>
            <path fill="#DECFB4" d="M0 510 Q 400 470 780 510 T 1440 500 V600 H0 Z" opacity=".7"/>
          </svg>
          {% else %}
          <svg viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
            <path fill="#EEE5D3" d="M0 440 Q 360 380 720 430 T 1440 410 V600 H0 Z" opacity=".7"/>
            <path fill="#E4D6BE" d="M0 500 Q 400 460 780 500 T 1440 490 V600 H0 Z" opacity=".7"/>
          </svg>
          {% endif %}
        </div>
        <div class="container">
          <div class="ambito__grid">
            <div class="ambito__main">
              <p class="eyebrow reveal">{{ a.eyebrow }}</p>
              <h2 class="display ambito__title blur-in">{{ a.title }}</h2>
              <p class="ambito__text reveal">{{ a.text }}</p>
              <a class="ambito__link reveal" href="{{ a.link_href }}">
                {{ a.link_text }}
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
            <div class="ambito__aside">
              <ul class="ambito__list reveal">
                {% for item in a.list %}<li>{{ item }}</li>{% endfor %}
              </ul>
            </div>
          </div>
        </div>
      </article>
      {% endfor %}
    </section>

    <!-- ===================== CITAZIONE ===================== -->
    <section class="quote" aria-label="Il mio approccio">
      <div class="container">
        <blockquote>
          <span class="js-words">{{ home.quote.text }}</span>
          <cite>{{ home.quote.cite }}</cite>
        </blockquote>
      </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="faq__paths" aria-hidden="true">
        <svg viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice">
          <path d="M-50 480 C 300 380 500 520 760 430 S 1200 340 1500 440"/>
          <path d="M-50 520 C 320 430 520 560 780 470 S 1220 380 1500 480"/>
          <path d="M-50 560 C 340 470 540 600 800 510 S 1240 420 1500 520"/>
        </svg>
      </div>
      <div class="container">
        <div class="faq__grid">
          <div class="faq__head">
            <p class="eyebrow reveal">{{ home.faq.eyebrow }}</p>
            <h2 class="display faq__title blur-in" id="faq-title">{{ home.faq.title }}</h2>
          </div>
          <div class="faq__list reveal">
            {% for f in home.faq.items %}
            <details class="faq__item" name="faq">
              <summary>{{ f.q }} <span class="faq__icon" aria-hidden="true"></span></summary>
              <div class="faq__answer">{{ f.a | safe }}</div>
            </details>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== CONTATTI / PRENOTA ===================== -->
    <section class="contatti" id="contatti" aria-labelledby="booking-title">
      <div class="container">
        <div class="booking" id="prenota">
          <span class="booking__badge reveal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            {{ home.booking.badge }}
          </span>
          <h2 class="display booking__title blur-in" id="booking-title">{{ home.booking.title }}</h2>
          <p class="booking__text reveal">{{ home.booking.text }}</p>
        </div>
      </div>
      <div class="container">
        <form class="form contatti__form reveal" id="contactForm" name="contatti" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="contatti" />
          <p hidden aria-hidden="true" style="display:none"><label>Lascia vuoto: <input name="bot-field" /></label></p>
          <div class="field">
            <label for="nome">Nome e cognome <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="nome" name="nome" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="ambito">Di cosa vorresti parlare?</label>
            <select id="ambito" name="ambito">
              <option value="">Seleziona un ambito…</option>
              <option>Percorso clinico / sostegno</option>
              <option>Percorso continuativo / formazione specialistica</option>
              <option>Ambito forense / consulenza</option>
              <option>Altro</option>
            </select>
          </div>
          <div class="field">
            <label for="messaggio">Messaggio <span class="req" aria-hidden="true">*</span></label>
            <textarea id="messaggio" name="messaggio" aria-describedby="messaggio-hint" required></textarea>
            <span id="messaggio-hint" class="field__hint">Poche righe bastano. Tratterò ogni informazione con la massima riservatezza.</span>
          </div>
          <label class="form__consent">
            <input type="checkbox" id="privacy" name="privacy" required />
            <span>{{ home.contatti.privacy_label | safe }} <span class="req" aria-hidden="true">*</span></span>
          </label>
          <button type="submit" class="btn btn--amber btn--center">Invia messaggio</button>
          <p class="form__note" id="formNote" role="status" aria-live="polite"></p>
        </form>
        <aside class="contact-details reveal" aria-labelledby="contact-details-title">
          <div class="contact-details__head">
            <p class="eyebrow">{{ home.contatti.eyebrow }}</p>
            <h3 class="sr-only" id="contact-details-title">Recapiti dello studio</h3>
            <p>{{ home.contatti.note }}</p>
          </div>
          <dl class="contact-details__list">
            <div>
              <dt>Email</dt>
              <dd>{{ site.email }}</dd>
            </div>
            <div>
              <dt>Telefono e WhatsApp</dt>
              <dd>{{ site.phone_display }}</dd>
            </div>
            <div>
              <dt>Sede</dt>
              <dd>{{ site.address_city }} · {{ site.address_street }}</dd>
            </div>
            <div>
              <dt>Online</dt>
              <dd>{{ home.contatti.online }}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>
  </main>
